# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. Nothing here is required to run the site —
# each block degrades gracefully when its variables are absent.

# ---------------------------------------------------------------------------
# Enquiry storage (optional in dev, strongly recommended in production)
# ---------------------------------------------------------------------------
# Provided automatically when you attach a Postgres database in Vercel.
# Without these, enquiries are written to ./data/contact-messages.json locally
# and to /tmp on Vercel (which does not survive a cold start).
POSTGRES_URL=

# ---------------------------------------------------------------------------
# Email notifications (optional — the form still saves without them)
# ---------------------------------------------------------------------------
# Any SMTP provider: Zoho Mail, Google Workspace, Fastmail, Resend SMTP, etc.
SMTP_HOST=
SMTP_PORT=465              # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@lunexatechnologies.com
MAIL_FROM_NAME=Lunexa Technologies Website
MAIL_TO=info@lunexatechnologies.com

# ---------------------------------------------------------------------------
# Admin dashboard at /admin (optional — stays closed unless all three are set)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Any long random string. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Analytics and search console (both optional)
# ---------------------------------------------------------------------------
# GA4 loads only for visitors outside the UK, EU/EEA and Switzerland, where
# consent would be required first. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
